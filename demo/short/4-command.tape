# prefix + : — Tab completes a command into a pill, its flags are explained
# and ticked off as you type them.
Output target/short/4-command.mp4
Source demo/short/settings.tape
Source demo/short/attach.tape

Sleep 500ms
Ctrl+B
Type ":"
Sleep 1.1s
Type "spl"
Sleep 900ms
Tab
Sleep 2s
Type "-h"
Sleep 700ms
Type " -l 35%"
Sleep 1.6s
Enter
Sleep 2s
