# Shared look for the vertical short's clips: a tall, narrow terminal with a
# big font, so it stays readable on a phone. Sourced by every scene tape; run
# them from the repo root (demo/short/make.sh does).
Require tmux
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 25
Set LineHeight 1.1
Set Width 1032
Set Height 1000
Set Padding 14
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set BorderRadius 14
Set Framerate 30
Set TypingSpeed 110ms
Env LANG "C.UTF-8"
Env LC_ALL "C.UTF-8"
