# Shared look for every clip — sourced by the other tapes. Run them from the
# repo root (demo/record.sh does).
Require tmux
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 16
Set LineHeight 1.1
Set Width 1280
Set Height 800
Set Padding 14
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set BorderRadius 10
Set Framerate 24
Set TypingSpeed 90ms
Env LANG "C.UTF-8"
Env LC_ALL "C.UTF-8"
